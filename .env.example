# Copia los valores al entorno local; no guardes credenciales reales en este archivo.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/<base>?retryWrites=true&w=majority
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:5173
SAFEROUTE_JWT_SECRET=reemplazar-por-secreto-aleatorio-de-al-menos-32-bytes
SAFEROUTE_JWT_TTL_MINUTES=20
# Aprovisionamiento inicial opcional. Retira estas variables tras iniciar la primera cuenta.
SAFEROUTE_BOOTSTRAP_ADMIN_EMAIL=
SAFEROUTE_BOOTSTRAP_ADMIN_PASSWORD=
VITE_API_URL=http://localhost:8080/api
